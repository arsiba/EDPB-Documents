         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">2020-Matthewâ€™s iMac</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Happy New 2021 Year at futuristic business city in isometric view. Abstract modern skyscrapers, employees work at downtown. Vector character illustration of metaphor successful business concept</rdf:li>
            </rdf:Alt>
         </dc:description>
